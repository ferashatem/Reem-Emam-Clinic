rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ── Helpers ──────────────────────────────────────────────────────────────
    // Only the clinic team has accounts. Visitors book from the public site
    // without signing in, so there is no "client" role anywhere below.

    function isAuth() {
      return request.auth != null;
    }

    function getUserData() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data;
    }

    function isSuperAdmin() {
      return isAuth() &&
        getUserData().role == 'super_admin' &&
        getUserData().is_active == true;
    }

    function isAdmin() {
      return isAuth() &&
        getUserData().role == 'admin' &&
        getUserData().is_active == true;
    }

    function isStaff() {
      return isAuth() &&
        getUserData().role == 'staff' &&
        getUserData().is_active == true;
    }

    // The two partners (and the owner) — they see the books and patient files
    function isAdminOrSuperAdmin() {
      return isSuperAdmin() || isAdmin();
    }

    // Any active internal team member (super_admin, admin, or staff)
    function isTeam() {
      return isSuperAdmin() || isAdmin() || isStaff();
    }

    function isShortString(value, maxLen) {
      return value is string && value.size() > 0 && value.size() <= maxLen;
    }

    // ── Users (team accounts) ────────────────────────────────────────────────
    match /users/{userId} {
      allow read: if isAuth() && request.auth.uid == userId;
      allow read: if isSuperAdmin();
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Settings ────────────────────────────────────────────────────────────
    match /settings/{docId} {
      allow read: if isTeam();
      allow write: if isSuperAdmin();
    }

    // ── Services — the public site lists these ──────────────────────────────
    match /services/{serviceId} {
      allow read: if true;
      allow create, update, delete: if isSuperAdmin();
    }

    // ── Contact requests — the landing page's "call me back" form ───────────
    match /contact_requests/{docId} {
      allow create: if isShortString(request.resource.data.name, 80) &&
        isShortString(request.resource.data.phone, 20);
      allow read: if isAdminOrSuperAdmin();
      allow update, delete: if isSuperAdmin();
    }

    // ── Patient files — internal only, never exposed to the public site ─────
    match /clients/{clientId} {
      allow read, create, update: if isTeam();
      allow delete: if isSuperAdmin();
    }

    // ── Reservations ────────────────────────────────────────────────────────
    match /reservations/{reservationId} {
      // A public booking request: no account, so it must be a pending request
      // with nothing but the visitor's own details — it cannot be confirmed,
      // priced as paid, or attached to an existing patient file.
      function isPublicBookingRequest() {
        return request.resource.data.status == 'pending' &&
          request.resource.data.booked_by == 'client' &&
          request.resource.data.client_id == null &&
          request.resource.data.admin_id == null &&
          request.resource.data.paid_amount == 0 &&
          request.resource.data.payment_status == 'unpaid' &&
          // Pricing only happens after the session — a request from the public
          // site can never arrive carrying a total.
          request.resource.data.price_at_booking == 0 &&
          // The line she booked into. It decides which room's hours she takes
          // and which set of books her money lands in, so it has to be one of
          // the two we actually run — not free text from the browser.
          request.resource.data.branch in ['laser', 'consult'] &&
          isShortString(request.resource.data.client_name, 80) &&
          isShortString(request.resource.data.client_phone, 20) &&
          isShortString(request.resource.data.date, 10) &&
          isShortString(request.resource.data.time, 5) &&
          request.resource.data.notes is string &&
          request.resource.data.notes.size() <= 500;
      }

      // Patient names and phones live here — team eyes only.
      allow read: if isTeam();

      allow create: if
        // Team member booking on a client's behalf, tagged with who did it
        (isTeam() && request.resource.data.admin_id == request.auth.uid) ||
        isPublicBookingRequest();

      allow update: if isTeam();
      allow delete: if isSuperAdmin();
    }

    // ── Availability — the day's load, with nobody's name on it ─────────────
    // The public booking form has to know what's still open without reading
    // /reservations (patient names and phones live there). So this holds one
    // doc per date *per line*: `2026-08-01` for the laser centre it has always
    // described, `2026-08-01_consult` for the كشف clinic beside it —
    // { used: { '13:00': 45 }, taken: ['13:00'] }, how many of each hour's 60
    // minutes are spoken for, and the hours with none left.
    //
    // Keying the line into the document id is what keeps the two rooms apart
    // here: a visitor's write below can only ever move one hour of the one day
    // she is booking, so she cannot reach into the other line's schedule.
    //
    // The team rebuilds it from the bookings on every write; a visitor may only
    // add her own session's minutes to a single hour, never clear the day.
    match /availability/{dayKey} {
      function isSlotList(value) {
        return value is list && value.size() <= 24;
      }

      function isUsageMap(value) {
        return value is map && value.size() <= 24;
      }

      // The minutes a visitor moved. One hour per request, and an hour's entry
      // may never be dropped — only the desk (an authenticated write above)
      // can lower or clear what a day already holds.
      function movesOneHour() {
        let before = resource.data.get('used', {});
        let diff = request.resource.data.used.diff(before);
        return diff.affectedKeys().size() == 1 && diff.removedKeys().size() == 0;
      }

      allow read: if true;
      allow write: if isTeam();

      allow create: if request.resource.data.keys().hasOnly(['taken', 'used']) &&
        isUsageMap(request.resource.data.used) &&
        request.resource.data.used.size() == 1 &&
        isSlotList(request.resource.data.taken) &&
        request.resource.data.taken.size() <= 1;

      allow update: if request.resource.data.keys().hasOnly(['taken', 'used']) &&
        isUsageMap(request.resource.data.used) &&
        isSlotList(request.resource.data.taken) &&
        request.resource.data.taken.hasAll(resource.data.get('taken', [])) &&
        movesOneHour();
    }

    // ── Timetable ───────────────────────────────────────────────────────────
    match /timetable/{slotId} {
      allow read: if isTeam();
      allow create, update: if isTeam();
      allow delete: if isSuperAdmin();
    }

    // ── Session reports — both partners share the full patient file ─────────
    match /session_reports/{reportId} {
      allow read: if isAdminOrSuperAdmin();
      allow create, update: if isAdminOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Reviews ─────────────────────────────────────────────────────────────
    match /reviews/{reviewId} {
      allow read: if isTeam();
      allow create, update: if isAdminOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Payments / collections (التحصيلات) ─────────────────────────────────
    match /payments/{paymentId} {
      allow read: if isTeam();
      allow create: if isTeam() &&
        request.resource.data.staff_id == request.auth.uid &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if isTeam();
      allow delete: if isSuperAdmin();
    }

    // ── Expenses (المصاريف) — only the partners touch the books ────────────
    match /expenses/{expenseId} {
      allow read: if isAdminOrSuperAdmin();
      allow create: if isAdminOrSuperAdmin() &&
        request.resource.data.amount is number &&
        request.resource.data.amount > 0;
      allow update: if isAdminOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Monthly closing (الجرد الشهري) ─────────────────────────────────────
    // Keyed `{YYYY-MM}` for the laser centre and `{YYYY-MM}_consult` for the
    // clinic — each line signs off its own month, so the month alone is no
    // longer unique.
    match /monthly_closings/{closingId} {
      allow read: if isAdminOrSuperAdmin();
      allow create, update: if isAdminOrSuperAdmin();
      allow delete: if isSuperAdmin();
    }

    // ── Notifications ───────────────────────────────────────────────────────
    match /notifications/{notifId} {
      allow read: if isTeam();
      allow create: if isTeam();
      allow update, delete: if isSuperAdmin();
    }
  }
}
